<!DOCTYPE html>
<html lang="ru" class={if assigns[:dark], do: "dark", else: ""}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content={get_csrf_token()} />
  <title>Jamboo</title>

  <!-- Подключение собранных стилей Tailwind -->
  <link rel="stylesheet" href={~p"/assets/app.css"} />

  <!-- Подключение HTMX: локальный файл + fallback на CDN -->
  {JambooWeb.LayoutHelpers.htmx_script_tag(@conn)}
</head>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100" hx-headers={Jason.encode!(%{"X-CSRF-Token" => get_csrf_token()})}>
  {@inner_content}
</body>
</html>
