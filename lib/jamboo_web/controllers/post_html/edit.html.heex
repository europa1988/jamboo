<div class="bg-white rounded-global shadow-sm p-6 mb-4 dark:bg-dark-card">
  <h1 class="text-2xl font-bold mb-6 dark:text-dark-text">Редактировать пост</h1>

  <.form for={@form} action={~p"/posts/#{@post.id}"} method="put" id="edit-post-form">
    <div class="mb-6">
      <label class="block text-gray-700 font-medium mb-2 dark:text-gray-300">Заголовок</label>
      <.input field={@form[:title]} type="text" />
    </div>
    <div class="mb-6">
      <label class="block text-gray-700 font-medium mb-2 dark:text-gray-300">Текст поста</label>
      <.input field={@form[:body]} type="textarea" rows="8" />
    </div>
    <div class="mb-6">
      <label class="block text-gray-700 font-medium mb-2 dark:text-gray-300">Ник</label>
      <.input field={@form[:author_nickname]} type="text" />
    </div>
    <div class="flex justify-end gap-3">
      <.link
        href={~p"/posts/#{@post.id}"}
        class="px-6 py-2 border border-jamboo-border rounded-button text-gray-700 hover:bg-gray-100 transition dark:text-gray-300 dark:hover:bg-gray-700"
      >
        Назад
      </.link>
      <button
        type="submit"
        class="px-6 py-2 bg-jamboo-orange text-white rounded-button hover:opacity-90 transition font-medium"
      >
        Сохранить
      </button>
    </div>
  </.form>
</div>
