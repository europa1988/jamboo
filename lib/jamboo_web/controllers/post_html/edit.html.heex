<div class="bg-white rounded-global shadow-sm p-6 mb-4 dark:bg-dark-card">
  <h1 class="text-2xl font-bold mb-6 dark:text-dark-text">Редактировать пост</h1>
  <.form for={@form} action={~p"/posts/#{@post.id}"} method="put" id="edit-post-form">
    <.input
      field={@form[:title]}
      label={gettext("Заголовок")}
      class="w-full py-3 px-4 bg-jamboo-light-gray border border-jamboo-border rounded-element focus:outline-none focus:ring-2 focus:ring-jamboo-blue transition text-gray-700 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
    />

    <.input
      field={@form[:body]}
      type="textarea"
      label={gettext("Текст поста")}
      rows="8"
      class="w-full py-3 px-4 bg-jamboo-light-gray border border-jamboo-border rounded-element focus:outline-none focus:ring-2 focus:ring-jamboo-blue transition text-gray-700 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
    />

    <.input
      field={@form[:author_nickname]}
      label={gettext("Ник")}
      class="w-full py-3 px-4 bg-jamboo-light-gray border border-jamboo-border rounded-element focus:outline-none focus:ring-2 focus:ring-jamboo-blue transition text-gray-700 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
    />

    <div class="flex justify-end gap-3 mt-6">
      <.button href={~p"/posts/#{@post.id}"} class="btn-outline">
        {gettext("Назад")}
      </.button>
      <.button type="submit" variant="primary">
        {gettext("Сохранить")}
      </.button>
    </div>
  </.form>
</div>
