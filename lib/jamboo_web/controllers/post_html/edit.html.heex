<div class="bg-white rounded-global shadow-sm p-6 mb-4 dark:bg-dark-card">
  <h1 class="text-2xl font-bold mb-6 dark:text-dark-text">Редактировать пост</h1>
  <.form for={@form} action={~p"/posts/#{@post}"} method="put">
    <.input field={@form[:title]} label="Заголовок" />
    <.input field={@form[:body]} type="textarea" label="Текст поста" rows="8" />
    <.input field={@form[:author_nickname]} label="Ник" />

    <div class="flex justify-end gap-3">
      <a href={~p"/posts/#{@post}"} class="px-6 py-2 border border-jamboo-border rounded-button text-gray-700 hover:bg-gray-100 transition dark:text-gray-300 dark:hover:bg-gray-700">Назад</a>
      <button type="submit" class="px-6 py-2 bg-jamboo-orange text-white rounded-button hover:opacity-90 transition font-medium">Сохранить</button>
    </div>
  </.form>
</div>