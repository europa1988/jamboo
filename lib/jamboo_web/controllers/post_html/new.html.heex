<div class="bg-white rounded-global shadow-sm p-6 mb-4 dark:bg-dark-card">
  <h1 class="text-2xl font-bold mb-6 dark:text-dark-text">Создать пост</h1>
  
  <.form :let={_f} for={@form} action={~p"/posts"} method="post" id="post-form">
    <div class="mb-6">
      <.input
        field={@form[:title]}
        type="text"
        label="Заголовок"
        placeholder="Придумайте заголовок"
      />
    </div>
    <div class="mb-6">
      <.input
        field={@form[:body]}
        type="textarea"
        rows="8"
        label="Текст поста"
        placeholder="Напишите что-нибудь..."
      />
    </div>
    <div class="mb-6">
      <.input
        field={@form[:author_nickname]}
        type="text"
        label="Ваш ник"
        placeholder="Как вас зовут?"
      />
    </div>
    <div class="flex justify-end gap-3">
      <button
        type="button"
        class="px-6 py-2 border border-jamboo-border rounded-button text-gray-700 hover:bg-gray-100 transition dark:text-gray-300 dark:hover:bg-gray-700"
      >
        Сохранить черновик
      </button>
      <button
        type="submit"
        class="px-6 py-2 bg-jamboo-orange text-white rounded-button hover:opacity-90 transition font-medium"
      >
        Опубликовать
      </button>
    </div>
  </.form>
</div>