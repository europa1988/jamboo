<div class="bg-white rounded-global shadow-sm p-6 mb-4 dark:bg-dark-card">
  <h1 class="text-2xl font-bold mb-6 dark:text-dark-text">Создать пост</h1>
  
  <.form for={@form} action={~p"/posts"} method="post" id="new-post-form">
    <.input field={@form[:title]} label="Заголовок" placeholder="Придумайте заголовок"
      class="w-full py-3 px-4 bg-jamboo-light-gray border border-jamboo-border rounded-element focus:outline-none focus:ring-2 focus:ring-jamboo-blue transition text-gray-700 dark:bg-gray-700 dark:border-gray-600 dark:text-white" />

    <.input field={@form[:body]} type="textarea" label="Текст поста" rows="8" placeholder="Напишите что-нибудь..."
      class="w-full py-3 px-4 bg-jamboo-light-gray border border-jamboo-border rounded-element focus:outline-none focus:ring-2 focus:ring-jamboo-blue transition text-gray-700 dark:bg-gray-700 dark:border-gray-600 dark:text-white" />

    <.input field={@form[:author_nickname]} label="Ваш ник" placeholder="Как вас зовут?"
      class="w-full py-3 px-4 bg-jamboo-light-gray border border-jamboo-border rounded-element focus:outline-none focus:ring-2 focus:ring-jamboo-blue transition text-gray-700 dark:bg-gray-700 dark:border-gray-600 dark:text-white" />

    <div class="flex justify-end gap-3 mt-6">
      <.button type="button" class="px-6 py-2 border border-jamboo-border rounded-button text-gray-700 hover:bg-gray-100 transition dark:text-gray-300 dark:hover:bg-gray-700">Сохранить черновик</.button>
      <.button type="submit" class="px-6 py-2 bg-jamboo-orange text-white rounded-button hover:opacity-90 transition font-medium">Опубликовать</.button>
    </div>
  </.form>
</div>
